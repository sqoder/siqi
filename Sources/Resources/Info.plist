<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>siqi</string>
    <key>CFBundleDisplayName</key>
    <string>siqi</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>CFBundleIconName</key>
    <string>AppIcon</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.developer-tools</string>
    <key>LSMinimumSystemVersion</key>
    <string>$(MACOSX_DEPLOYMENT_TARGET)</string>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2026 sqoder. MIT License.</string>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSRequiresAquaSystemAppearance</key>
    <false/>
    <key>NSSupportsAutomaticGraphicsSwitching</key>
    <true/>
    <key>NSAppleEventsUsageDescription</key>
    <string>siqi allows terminal sessions and scripts to send Apple Events for automation.</string>
    <key>NSCameraUsageDescription</key>
    <string>siqi requests camera access only when a command-line process inside the terminal requests it.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>siqi requests microphone access only when a command-line process inside the terminal requests it.</string>
    <key>NSDesktopFolderUsageDescription</key>
    <string>siqi needs access to your Desktop folder when shell commands read or write files there.</string>
    <key>NSDocumentsFolderUsageDescription</key>
    <string>siqi needs access to your Documents folder when shell commands read or write files there.</string>
    <key>NSDownloadsFolderUsageDescription</key>
    <string>siqi needs access to your Downloads folder when shell commands read or write files there.</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>siqi needs local network access when terminal tools connect to services on your local network.</string>
    <key>NSNetworkVolumesUsageDescription</key>
    <string>siqi needs access to network volumes when shell commands operate on mounted shares.</string>
    <key>NSRemovableVolumesUsageDescription</key>
    <string>siqi needs access to removable volumes when shell commands operate on external drives.</string>
    <key>NSSystemAdministrationUsageDescription</key>
    <string>siqi requires administrator authorization when shell commands request elevated privileges.</string>
    <key>NSServices</key>
    <array>
        <dict>
            <key>NSMenuItem</key>
            <dict>
                <key>default</key>
                <string>Open in Siqi</string>
            </dict>
            <key>NSMessage</key>
            <string>openInSiqi</string>
            <key>NSPortName</key>
            <string>siqi</string>
            <key>NSSendTypes</key>
            <array>
                <string>public.file-url</string>
                <string>NSFilenamesPboardType</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
